ARG JAVA_IMAGE=m.daocloud.io/docker.io/eclipse-temurin:8-jre

FROM ${JAVA_IMAGE}
WORKDIR /opt/ft-mes
COPY backend/source-modules/mes-production-context-outbox/target/mes-production-context-outbox-0.1.0-SNAPSHOT.jar app.jar
USER 10001:10001
EXPOSE 19082
ENTRYPOINT ["java", "-jar", "/opt/ft-mes/app.jar"]
