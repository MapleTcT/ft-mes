{
  "asyncapi": "3.0.0",
  "info": {"title": "FT MES BPI Event API", "version": "1.0.0-shadow", "description": "Kafka topic and Protobuf message catalog for BPI."},
  "defaultContentType": "application/x-protobuf",
  "servers": {
    "kafka": {"host": "kafka:9092", "protocol": "kafka", "description": "Environment-specific Kafka bootstrap address"}
  },
  "channels": {
    "selectedTelemetry": {
      "address": "iot.telemetry.selected.v1",
      "messages": {"telemetry": {"$ref": "#/components/messages/TelemetryEnvelopeV1"}},
      "description": "Selected P1/P2/P3 telemetry keyed by plantId+deviceId"
    },
    "pointCatalogSnapshot": {
      "address": "iot.point-catalog.snapshot.v1",
      "messages": {"snapshot": {"$ref": "#/components/messages/PointCatalogSnapshotV1"}},
      "description": "Immutable JetLinks point catalog snapshots keyed by tenantId+plantId+lineId+sourceInstance"
    },
    "pointCatalogSnapshotDlq": {
      "address": "iot.point-catalog.snapshot.dlq.v1",
      "messages": {"snapshot": {"$ref": "#/components/messages/PointCatalogSnapshotV1"}},
      "description": "Rejected or retry-exhausted point catalog snapshots with Spring Kafka DLT headers"
    },
    "productionContext": {
      "address": "mes.production.context.v1",
      "messages": {"context": {"$ref": "#/components/messages/ProductionContextEventV1"}},
      "description": "WOM order/task context keyed by orderId+taskId"
    },
    "boundaryRulePublication": {
      "address": "bpi.boundary.rule-publication.v1",
      "messages": {"rule": {"$ref": "#/components/messages/BoundaryRulePublicationV1"}},
      "description": "Immutable approved rule/topology/binding publications keyed by tenantId+lineId+ruleCode+ruleVersion"
    },
    "boundaryRuleApplication": {
      "address": "bpi.boundary.rule-application.v1",
      "messages": {"application": {"$ref": "#/components/messages/BoundaryRuleApplicationV1"}},
      "description": "Flink checkpoint-committed APPLIED/REJECTED receipts keyed by publicationEventId"
    },
    "boundaryRuleApplicationDlq": {
      "address": "bpi.boundary.rule-application.dlq.v1",
      "messages": {"application": {"$ref": "#/components/messages/BoundaryRuleApplicationV1"}},
      "description": "Rejected or retry-exhausted rule application receipts with Spring Kafka DLT headers"
    },
    "boundaryRuleRuntimeReadiness": {
      "address": "bpi.boundary.rule-runtime-readiness.v1",
      "messages": {"readiness": {"$ref": "#/components/messages/BoundaryRuleRuntimeReadinessV1"}},
      "description": "Flink runtime point-catalog admission receipts keyed by publicationEventId; independent from lifecycle application"
    },
    "boundaryRuleRuntimeReadinessDlq": {
      "address": "bpi.boundary.rule-runtime-readiness.dlq.v1",
      "messages": {"readiness": {"$ref": "#/components/messages/BoundaryRuleRuntimeReadinessV1"}},
      "description": "Rejected or retry-exhausted runtime-readiness receipts with Spring Kafka DLT headers"
    },
    "batchCandidate": {
      "address": "bpi.batch.candidate.v1",
      "messages": {"candidate": {"$ref": "#/components/messages/BatchCandidateV1"}},
      "description": "Deterministic START/END candidates keyed by lineId+ruleCode"
    },
    "batchCandidateDlq": {
      "address": "bpi.batch.candidate.dlq.v1",
      "messages": {"candidate": {"$ref": "#/components/messages/BatchCandidateV1"}},
      "description": "Rejected or retry-exhausted candidate records with Spring Kafka DLT headers"
    },
    "batchFact": {
      "address": "bpi.batch.fact.v1",
      "messages": {"fact": {"$ref": "#/components/messages/BatchFactV1"}},
      "description": "Published BPI facts keyed by batchId; schema is reserved for Phase 2"
    },
    "dataQuality": {
      "address": "bpi.data-quality.v1",
      "messages": {"quality": {"$ref": "#/components/messages/DataQualityEventV1"}},
      "description": "Point/envelope quality events keyed by source+propertyId"
    },
    "trainingSnapshot": {
      "address": "bpi.training.snapshot.v1",
      "messages": {"snapshot": {"$ref": "#/components/messages/TrainingSnapshotV1"}},
      "description": "Immutable training snapshot notifications keyed by datasetId"
    }
  },
  "operations": {
    "consumeSelectedTelemetry": {"action": "receive", "channel": {"$ref": "#/channels/selectedTelemetry"}, "messages": [{"$ref": "#/channels/selectedTelemetry/messages/telemetry"}]},
    "consumePointCatalogSnapshot": {"action": "receive", "channel": {"$ref": "#/channels/pointCatalogSnapshot"}, "messages": [{"$ref": "#/channels/pointCatalogSnapshot/messages/snapshot"}]},
    "publishRejectedPointCatalogSnapshot": {"action": "send", "channel": {"$ref": "#/channels/pointCatalogSnapshotDlq"}, "messages": [{"$ref": "#/channels/pointCatalogSnapshotDlq/messages/snapshot"}]},
    "consumeProductionContext": {"action": "receive", "channel": {"$ref": "#/channels/productionContext"}, "messages": [{"$ref": "#/channels/productionContext/messages/context"}]},
    "consumeBoundaryRulePublication": {"action": "receive", "channel": {"$ref": "#/channels/boundaryRulePublication"}, "messages": [{"$ref": "#/channels/boundaryRulePublication/messages/rule"}]},
    "publishBoundaryRuleApplication": {"action": "send", "channel": {"$ref": "#/channels/boundaryRuleApplication"}, "messages": [{"$ref": "#/channels/boundaryRuleApplication/messages/application"}]},
    "consumeBoundaryRuleApplication": {"action": "receive", "channel": {"$ref": "#/channels/boundaryRuleApplication"}, "messages": [{"$ref": "#/channels/boundaryRuleApplication/messages/application"}]},
    "publishRejectedBoundaryRuleApplication": {"action": "send", "channel": {"$ref": "#/channels/boundaryRuleApplicationDlq"}, "messages": [{"$ref": "#/channels/boundaryRuleApplicationDlq/messages/application"}]},
    "publishBoundaryRuleRuntimeReadiness": {"action": "send", "channel": {"$ref": "#/channels/boundaryRuleRuntimeReadiness"}, "messages": [{"$ref": "#/channels/boundaryRuleRuntimeReadiness/messages/readiness"}]},
    "consumeBoundaryRuleRuntimeReadiness": {"action": "receive", "channel": {"$ref": "#/channels/boundaryRuleRuntimeReadiness"}, "messages": [{"$ref": "#/channels/boundaryRuleRuntimeReadiness/messages/readiness"}]},
    "publishRejectedBoundaryRuleRuntimeReadiness": {"action": "send", "channel": {"$ref": "#/channels/boundaryRuleRuntimeReadinessDlq"}, "messages": [{"$ref": "#/channels/boundaryRuleRuntimeReadinessDlq/messages/readiness"}]},
    "consumeBatchCandidate": {"action": "receive", "channel": {"$ref": "#/channels/batchCandidate"}, "messages": [{"$ref": "#/channels/batchCandidate/messages/candidate"}]},
    "publishRejectedBatchCandidate": {"action": "send", "channel": {"$ref": "#/channels/batchCandidateDlq"}, "messages": [{"$ref": "#/channels/batchCandidateDlq/messages/candidate"}]},
    "publishBatchFact": {"action": "send", "channel": {"$ref": "#/channels/batchFact"}, "messages": [{"$ref": "#/channels/batchFact/messages/fact"}]},
    "consumeDataQuality": {"action": "receive", "channel": {"$ref": "#/channels/dataQuality"}, "messages": [{"$ref": "#/channels/dataQuality/messages/quality"}]},
    "publishTrainingSnapshot": {"action": "send", "channel": {"$ref": "#/channels/trainingSnapshot"}, "messages": [{"$ref": "#/channels/trainingSnapshot/messages/snapshot"}]}
  },
  "components": {
    "messages": {
      "TelemetryEnvelopeV1": {"name": "TelemetryEnvelopeV1", "contentType": "application/x-protobuf", "headers": {"$ref": "#/components/schemas/EventHeaders"}, "payload": {"schemaFormat": "application/vnd.google.protobuf;version=3", "schema": {"x-protobuf-file": "contracts/bpi-events/src/main/proto/bpi_events_v1.proto", "x-protobuf-message": "ftmes.bpi.contract.v1.TelemetryEnvelopeV1"}}},
      "PointCatalogSnapshotV1": {"name": "PointCatalogSnapshotV1", "contentType": "application/x-protobuf", "headers": {"$ref": "#/components/schemas/PointCatalogKafkaHeaders"}, "payload": {"schemaFormat": "application/vnd.google.protobuf;version=3", "schema": {"x-protobuf-file": "contracts/bpi-events/src/main/proto/bpi_events_v1.proto", "x-protobuf-message": "ftmes.bpi.contract.v1.PointCatalogSnapshotV1"}}},
      "ProductionContextEventV1": {"name": "ProductionContextEventV1", "contentType": "application/x-protobuf", "headers": {"$ref": "#/components/schemas/EventHeaders"}, "payload": {"schemaFormat": "application/vnd.google.protobuf;version=3", "schema": {"x-protobuf-file": "contracts/bpi-events/src/main/proto/bpi_events_v1.proto", "x-protobuf-message": "ftmes.bpi.contract.v1.ProductionContextEventV1"}}},
      "BoundaryRulePublicationV1": {"name": "BoundaryRulePublicationV1", "contentType": "application/x-protobuf", "headers": {"$ref": "#/components/schemas/EventHeaders"}, "payload": {"schemaFormat": "application/vnd.google.protobuf;version=3", "schema": {"x-protobuf-file": "contracts/bpi-events/src/main/proto/bpi_events_v1.proto", "x-protobuf-message": "ftmes.bpi.contract.v1.BoundaryRulePublicationV1"}}},
      "BoundaryRuleApplicationV1": {"name": "BoundaryRuleApplicationV1", "contentType": "application/x-protobuf", "headers": {"$ref": "#/components/schemas/RuleApplicationKafkaHeaders"}, "payload": {"schemaFormat": "application/vnd.google.protobuf;version=3", "schema": {"x-protobuf-file": "contracts/bpi-events/src/main/proto/bpi_events_v1.proto", "x-protobuf-message": "ftmes.bpi.contract.v1.BoundaryRuleApplicationV1"}}},
      "BoundaryRuleRuntimeReadinessV1": {"name": "BoundaryRuleRuntimeReadinessV1", "contentType": "application/x-protobuf", "headers": {"$ref": "#/components/schemas/RuleRuntimeReadinessKafkaHeaders"}, "payload": {"schemaFormat": "application/vnd.google.protobuf;version=3", "schema": {"x-protobuf-file": "contracts/bpi-events/src/main/proto/bpi_events_v1.proto", "x-protobuf-message": "ftmes.bpi.contract.v1.BoundaryRuleRuntimeReadinessV1"}}},
      "BatchCandidateV1": {"name": "BatchCandidateV1", "contentType": "application/x-protobuf", "headers": {"$ref": "#/components/schemas/CandidateKafkaHeaders"}, "payload": {"schemaFormat": "application/vnd.google.protobuf;version=3", "schema": {"x-protobuf-file": "contracts/bpi-events/src/main/proto/bpi_events_v1.proto", "x-protobuf-message": "ftmes.bpi.contract.v1.BatchCandidateV1"}}},
      "DataQualityEventV1": {"name": "DataQualityEventV1", "contentType": "application/x-protobuf", "headers": {"$ref": "#/components/schemas/EventHeaders"}, "payload": {"schemaFormat": "application/vnd.google.protobuf;version=3", "schema": {"x-protobuf-file": "contracts/bpi-events/src/main/proto/bpi_events_v1.proto", "x-protobuf-message": "ftmes.bpi.contract.v1.DataQualityEventV1"}}},
      "BatchFactV1": {"name": "BatchFactV1", "contentType": "application/x-protobuf", "payload": {"schemaFormat": "application/vnd.google.protobuf;version=3", "schema": {"x-phase": "2", "x-status": "RESERVED_NOT_IMPLEMENTED"}}},
      "TrainingSnapshotV1": {"name": "TrainingSnapshotV1", "contentType": "application/x-protobuf", "payload": {"schemaFormat": "application/vnd.google.protobuf;version=3", "schema": {"x-phase": "3", "x-status": "RESERVED_NOT_IMPLEMENTED"}}}
    },
    "schemas": {
      "EventHeaders": {"type": "object", "required": ["eventId", "tenantId", "traceId", "schemaVersion"], "properties": {"eventId": {"type": "string"}, "tenantId": {"type": "string"}, "traceId": {"type": "string"}, "schemaVersion": {"type": "string"}, "payloadChecksum": {"type": "string"}}},
      "CandidateKafkaHeaders": {"type": "object", "required": ["event_id", "candidate_key", "tenant_id", "schema_version"], "properties": {"event_id": {"type": "string"}, "candidate_key": {"type": "string", "format": "uuid"}, "tenant_id": {"type": "string"}, "schema_version": {"const": "v1"}}},
      "PointCatalogKafkaHeaders": {"type": "object", "required": ["event_id", "tenant_id", "source_revision", "schema_version"], "properties": {"event_id": {"type": "string"}, "tenant_id": {"type": "string"}, "source_revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "schema_version": {"const": "v1"}}},
      "RuleApplicationKafkaHeaders": {"type": "object", "required": ["event_id", "publication_event_id", "tenant_id", "status", "schema_version"], "properties": {"event_id": {"type": "string"}, "publication_event_id": {"type": "string", "format": "uuid"}, "tenant_id": {"type": "string"}, "status": {"enum": ["APPLIED", "REJECTED"]}, "schema_version": {"const": "v1"}}},
      "RuleRuntimeReadinessKafkaHeaders": {"type": "object", "required": ["event_id", "publication_event_id", "tenant_id", "status", "schema_version"], "properties": {"event_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "publication_event_id": {"type": "string", "format": "uuid"}, "tenant_id": {"type": "string"}, "status": {"enum": ["READY", "DEGRADED", "INACTIVE"]}, "schema_version": {"const": "v1"}}}
    }
  }
}
