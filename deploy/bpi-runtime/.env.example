COMPOSE_PROJECT_NAME=ft-mes-bpi-runtime
BPI_BIND_ADDRESS=127.0.0.1
BPI_HTTP_PORT=19091
BPI_WEB_BIND_ADDRESS=127.0.0.1
BPI_WEB_PORT=18090
ADP_RUNTIME_NETWORK_NAME=adp-mes-newbase_default

POSTGRES_IMAGE=m.daocloud.io/docker.io/library/postgres:15-alpine
MINIO_IMAGE=m.daocloud.io/docker.io/minio/minio:latest
MINIO_MC_IMAGE=m.daocloud.io/docker.io/minio/mc:latest
BPI_JAVA_IMAGE=m.daocloud.io/docker.io/eclipse-temurin:17-jre-jammy
BPI_SERVICE_IMAGE=ft-mes-bpi-service:local
BPI_DATASET_MATERIALIZER_PYTHON_IMAGE=m.daocloud.io/docker.io/library/python:3.12.13-slim-bookworm
BPI_DATASET_MATERIALIZER_IMAGE=ft-mes-bpi-dataset-materializer:local
BPI_ADAPTER_JAVA_IMAGE=m.daocloud.io/docker.io/eclipse-temurin:8-jre
BPI_ADAPTER_IMAGE=ft-mes-bpi-adapter:local
BPI_NGINX_IMAGE=m.daocloud.io/docker.io/library/nginx:1.24.0

POSTGRES_DB=postgres
POSTGRES_USER=bpi_admin
POSTGRES_PASSWORD=change-me-postgres-admin
BPI_DATABASE_NAME=ft_mes_bpi
BPI_EXPECTED_FLYWAY_VERSION=27
BPI_DATABASE_PASSWORD=change-me-bpi-service
BPI_MIGRATOR_PASSWORD=change-me-bpi-migrator
BPI_MATERIALIZER_DATABASE_PASSWORD=change-me-bpi-materializer
BPI_INTERNAL_JWT_SECRET=change-me-at-least-32-characters-long
BPI_INTERNAL_JWT_ISSUER=ft-mes-adapter
BPI_INTERNAL_JWT_AUDIENCE=bpi-service

MINIO_ROOT_USER=change-me-minio-root
MINIO_ROOT_PASSWORD=change-me-minio-root-secret
BPI_DATASET_BUCKET_BOOTSTRAP_ENABLED=false
BPI_DATASET_MINIO_ACCESS_KEY=bpi-materializer
BPI_DATASET_MINIO_SECRET_KEY=change-me-bpi-materializer-minio
BPI_DATASET_MINIO_BUCKET=bpi-datasets
BPI_DATASET_MATERIALIZER_ENABLED=false
BPI_DATASET_MATERIALIZER_POLL_SECONDS=2
BPI_DATASET_MATERIALIZER_CLAIM_TIMEOUT_SECONDS=300
BPI_DATASET_MATERIALIZER_MAX_ATTEMPTS=3

BPI_ADAPTER_KEYCLOAK_JWK_SET_URI=http://keycloak:8080/auth/realms/dt/protocol/openid-connect/certs
BPI_ADAPTER_KEYCLOAK_ISSUER=http://127.0.0.1:8080/auth/realms/dt
BPI_ADAPTER_KEYCLOAK_AUDIENCE=pc_dt
BPI_ADAPTER_LEGACY_TICKET_ENABLED=true
BPI_ADAPTER_LEGACY_GATEWAY_BASE_URL=http://gateway:8008
BPI_ADAPTER_TENANT_CLAIM=companyId
BPI_ADAPTER_USERNAME_CLAIM=userName
BPI_ADAPTER_INTERNAL_TOKEN_TTL=10m
BPI_ADAPTER_ROLE_RULES=systemRole=BPI_ADMIN|BPI_OPERATOR
BPI_ADAPTER_SUBJECT_SCOPE_RULES=admin=1000|PLANT-01|LINE-S07-01

BPI_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:29092,127.0.0.1:39092,127.0.0.1:49092
BPI_CANDIDATE_KAFKA_ENABLED=false
BPI_CANDIDATE_KAFKA_ALLOWED_TENANT_IDS=_DENY_ALL_
BPI_CANDIDATE_KAFKA_ALLOWED_PLANT_IDS=_DENY_ALL_
BPI_CANDIDATE_KAFKA_ALLOWED_LINE_IDS=_DENY_ALL_
BPI_DATA_QUALITY_KAFKA_ENABLED=false
BPI_DATA_QUALITY_KAFKA_TOPIC=bpi.data-quality.v1
BPI_DATA_QUALITY_KAFKA_DLQ_TOPIC=bpi.data-quality.dlq.v1
BPI_DATA_QUALITY_KAFKA_ALLOWED_TENANT_IDS=_DENY_ALL_
BPI_DATA_QUALITY_KAFKA_ALLOWED_PLANT_IDS=_DENY_ALL_
BPI_DATA_QUALITY_KAFKA_ALLOWED_LINE_IDS=_DENY_ALL_
BPI_DATA_QUALITY_KAFKA_MAX_PAYLOAD_BYTES=65536
BPI_POINT_CATALOG_KAFKA_ENABLED=false
BPI_POINT_CATALOG_KAFKA_ALLOWED_TENANT_IDS=_DENY_ALL_
BPI_POINT_CATALOG_KAFKA_ALLOWED_PLANT_IDS=_DENY_ALL_
BPI_POINT_CATALOG_KAFKA_ALLOWED_LINE_IDS=_DENY_ALL_
BPI_POINT_CATALOG_KAFKA_MAX_PAYLOAD_BYTES=5242880
BPI_SOURCE_SEQUENCE_KAFKA_ENABLED=false
BPI_SOURCE_SEQUENCE_KAFKA_TOPIC=iot.source-sequence.evidence.v1
BPI_SOURCE_SEQUENCE_KAFKA_DLQ_TOPIC=iot.source-sequence.evidence.dlq.v1
BPI_SOURCE_SEQUENCE_KAFKA_ALLOWED_TENANT_IDS=_DENY_ALL_
BPI_SOURCE_SEQUENCE_KAFKA_ALLOWED_PLANT_IDS=_DENY_ALL_
BPI_SOURCE_SEQUENCE_KAFKA_ALLOWED_LINE_IDS=_DENY_ALL_
BPI_SOURCE_SEQUENCE_KAFKA_MAX_PAYLOAD_BYTES=65536
BPI_RULE_PUBLICATION_OUTBOX_ENABLED=false
BPI_RULE_APPLICATION_KAFKA_ENABLED=false
BPI_RULE_APPLICATION_KAFKA_TOPIC=bpi.boundary.rule-application.v1
BPI_RULE_APPLICATION_KAFKA_DLQ_TOPIC=bpi.boundary.rule-application.dlq.v1
BPI_RULE_RUNTIME_READINESS_KAFKA_TOPIC=bpi.boundary.rule-runtime-readiness.v1
BPI_RULE_RUNTIME_READINESS_KAFKA_DLQ_TOPIC=bpi.boundary.rule-runtime-readiness.dlq.v1
BPI_RULE_APPLICATION_KAFKA_ALLOWED_TENANT_IDS=_DENY_ALL_
BPI_RULE_APPLICATION_KAFKA_ALLOWED_PLANT_IDS=_DENY_ALL_
BPI_RULE_APPLICATION_KAFKA_ALLOWED_LINE_IDS=_DENY_ALL_
BPI_PHASE2_INTEGRATION_ENABLED=false
BPI_PHASE2_PROTOBUF_HTTP_INGRESS_ENABLED=false
BPI_PHASE2_KAFKA_ENABLED=false
BPI_PHASE2_QCS_TOPIC=qcs.batch.quality-gate.v1
BPI_PHASE2_QCS_DLQ_TOPIC=qcs.batch.quality-gate.dlq.v1
BPI_PHASE2_WMS_RECEIPT_TOPIC=wms.completion-inbound.receipt.v1
BPI_PHASE2_WMS_RECEIPT_DLQ_TOPIC=wms.completion-inbound.receipt.dlq.v1
BPI_PHASE2_ALLOWED_TENANT_IDS=_DENY_ALL_
BPI_PHASE2_ALLOWED_PLANT_IDS=_DENY_ALL_
BPI_PHASE2_ALLOWED_LINE_IDS=_DENY_ALL_
BPI_WMS_OUTBOX_ENABLED=false
BPI_WMS_OUTBOX_TOPIC=bpi.wms.completion-inbound-command.v1
BPI_WMS_RECONCILIATION_DELAY=5m
BPI_WMS_ADAPTER_ENABLED=false
BPI_WMS_ADAPTER_COMMAND_TOPIC=bpi.wms.completion-inbound-command.v1
BPI_WMS_ADAPTER_COMMAND_DLQ_TOPIC=bpi.wms.completion-inbound-command.dlq.v1
BPI_WMS_ADAPTER_RECEIPT_TOPIC=wms.completion-inbound.receipt.v1
BPI_WMS_ADAPTER_ROUTES=_DENY_ALL_
BPI_WMS_ADAPTER_MATERIAL_BASE_URL=http://material:8080
BPI_WMS_ADAPTER_HTTP_PORT=19092
MATERIAL_WMS_BPI_API_KEY=_DISABLED_
