BPI_POLARIS_IMAGE=apache/polaris:1.4.1
BPI_POLARIS_ADMIN_IMAGE=apache/polaris-admin-tool:1.4.1
BPI_ADAPTER_JAVA_IMAGE=m.daocloud.io/docker.io/eclipse-temurin:8-jre
BPI_ADAPTER_IMAGE=ft-mes-bpi-adapter:local
BPI_NGINX_IMAGE=m.daocloud.io/docker.io/library/nginx:1.24.0

POSTGRES_DB=postgres
POSTGRES_USER=bpi_admin
POSTGRES_PASSWORD=change-me-postgres-admin
BPI_DATABASE_NAME=ft_mes_bpi
BPI_EXPECTED_FLYWAY_VERSION=29
BPI_DATABASE_PASSWORD=change-me-bpi-service
BPI_MIGRATOR_PASSWORD=change-me-bpi-migrator
BPI_MATERIALIZER_DATABASE_PASSWORD=change-me-bpi-materializer
BPI_CATALOG_PUBLISHER_DATABASE_PASSWORD=change-me-bpi-catalog-publisher
BPI_RETENTION_ARCHIVER_DATABASE_PASSWORD=change-me-bpi-retention-archiver
BPI_INTERNAL_JWT_SECRET=change-me-at-least-32-characters-long
BPI_INTERNAL_JWT_ISSUER=ft-mes-adapter
BPI_INTERNAL_JWT_AUDIENCE=bpi-service

MINIO_ROOT_USER=change-me-minio-root
MINIO_ROOT_PASSWORD=change-me-minio-root-secret
BPI_DATASET_BUCKET_BOOTSTRAP_ENABLED=false
BPI_DATASET_MINIO_ACCESS_KEY=bpi-materializer
BPI_DATASET_MINIO_SECRET_KEY=change-me-bpi-materializer-minio
BPI_DATASET_MINIO_BUCKET=bpi-datasets
BPI_DATASET_SOURCE_READER_ENABLED=false
BPI_DATASET_SOURCE_READER_ACCESS_KEY=bpi-catalog-source-reader
BPI_DATASET_SOURCE_READER_SECRET_KEY=change-me-bpi-catalog-source-reader-minio
BPI_DATASET_MATERIALIZER_ENABLED=false
BPI_DATASET_MATERIALIZER_POLL_SECONDS=2
BPI_DATASET_MATERIALIZER_CLAIM_TIMEOUT_SECONDS=300
BPI_DATASET_MATERIALIZER_MAX_ATTEMPTS=3

BPI_POLARIS_ENABLED=false
BPI_POLARIS_ALLOW_INSECURE_STORAGE_TYPES=false
BPI_POLARIS_DROP_WITH_PURGE_ENABLED=false
BPI_POLARIS_IGNORE_SEVERE_READINESS_ISSUES=false
BPI_POLARIS_CATALOG_BOOTSTRAP_ENABLED=false
BPI_POLARIS_PUBLISHER_CREDENTIAL_ROTATION_ENABLED=false
BPI_POLARIS_RECOVERY_CREDENTIAL_ROTATION_ENABLED=false
BPI_POLARIS_DATABASE_PASSWORD=change-me-polaris-postgres
BPI_POLARIS_REALM=POLARIS
BPI_POLARIS_BOOTSTRAP_CLIENT_ID=bpi-polaris-root
BPI_POLARIS_BOOTSTRAP_CLIENT_SECRET=change-me-polaris-root-client
BPI_POLARIS_TOKEN_BROKER_SECRET=change-me-fixed-token-broker-secret-at-least-32-characters
BPI_ICEBERG_WAREHOUSE_BOOTSTRAP_ENABLED=false
BPI_ICEBERG_WAREHOUSE_BUCKET=bpi-iceberg-warehouse
BPI_ICEBERG_MINIO_ACCESS_KEY=bpi-polaris-warehouse
BPI_ICEBERG_MINIO_SECRET_KEY=change-me-bpi-polaris-warehouse-minio
BPI_ICEBERG_S3_ENDPOINT_EXTERNAL=http://bpi-minio:9000
BPI_ICEBERG_S3_REGION=us-east-1
BPI_DATASET_CATALOG_PUBLISHER_ENABLED=false
BPI_DATASET_CATALOG_PUBLISHER_POLL_SECONDS=2
BPI_DATASET_CATALOG_PUBLISHER_CLAIM_TIMEOUT_SECONDS=300
BPI_DATASET_CATALOG_PUBLISHER_MAX_ATTEMPTS=3
BPI_DATASET_RECOVERY_BUCKET_BOOTSTRAP_ENABLED=false
BPI_DATASET_RETENTION_ARCHIVER_ENABLED=false
BPI_DATASET_RETENTION_MINIO_ACCESS_KEY=bpi-retention-archiver
BPI_DATASET_RETENTION_MINIO_SECRET_KEY=change-me-bpi-retention-archiver-minio
BPI_DATASET_RECOVERY_MINIO_ACCESS_KEY=bpi-dataset-recovery-operator
BPI_DATASET_RECOVERY_MINIO_SECRET_KEY=change-me-bpi-dataset-recovery-operator-minio
BPI_DATASET_RECOVERY_BUCKET=bpi-dataset-recovery
BPI_DATASET_RECOVERY_RECONCILE_STALE=false
BPI_DATASET_RETENTION_MODE=GOVERNANCE
BPI_DATASET_RETENTION_DAYS=30
BPI_DATASET_RETENTION_LEGAL_HOLD=false
BPI_DATASET_RETENTION_ARCHIVER_POLL_SECONDS=2
BPI_DATASET_RETENTION_ARCHIVER_CLAIM_TIMEOUT_SECONDS=300
BPI_DATASET_RETENTION_ARCHIVER_MAX_ATTEMPTS=3

BPI_ADAPTER_KEYCLOAK_JWK_SET_URI=http://keycloak:8080/auth/realms/dt/protocol/openid-connect/certs
BPI_ADAPTER_KEYCLOAK_ISSUER=http://127.0.0.1:8080/auth/realms/dt
BPI_ADAPTER_KEYCLOAK_AUDIENCE=pc_dt
BPI_ADAPTER_LEGACY_TICKET_ENABLED=true
BPI_ADAPTER_LEGACY_GATEWAY_BASE_URL=http://gateway:8008
BPI_ADAPTER_TENANT_CLAIM=companyId
BPI_ADAPTER_USERNAME_CLAIM=userName
BPI_ADAPTER_INTERNAL_TOKEN_TTL=10m
BPI_ADAPTER_ROLE_RULES=systemRole=BPI_ADMIN|BPI_OPERATOR
BPI_ADAPTER_SUBJECT_SCOPE_RULES=admin=1000|PLANT-01|LINE-S07-01

