# Isolated BPI Kafka/Flink test deployment. Copy to .env on the target host.
COMPOSE_PROJECT_NAME=ft-mes-bpi-streaming
TZ=Asia/Shanghai

# Keep diagnostics private by default. Set both values to the Tailscale address
# only when remote Kafka diagnostics are required.
BPI_BIND_ADDRESS=127.0.0.1
BPI_KAFKA_ADVERTISED_HOST=127.0.0.1
BPI_KAFKA_1_PORT=29092
BPI_KAFKA_2_PORT=39092
BPI_KAFKA_3_PORT=49092
BPI_FLINK_REST_PORT=18081

BPI_KAFKA_IMAGE=apache/kafka:4.2.0
BPI_FLINK_IMAGE=flink:2.2.1-scala_2.12-java17
BPI_MINIO_IMAGE=minio/minio:RELEASE.2025-07-18T21-56-31Z
BPI_MINIO_MC_IMAGE=minio/mc:RELEASE.2025-07-21T05-28-08Z
BPI_KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw

BPI_MINIO_ROOT_USER=bpi-checkpoint
BPI_MINIO_ROOT_PASSWORD=change-me-before-deploy-32-characters
BPI_CHECKPOINT_BUCKET=ft-mes-bpi-checkpoints

# This path is resolved from deploy/bpi-streaming/docker-compose.yml.
BPI_JOB_JAR=../../streaming/bpi-stream-engine/target/bpi-stream-engine-0.1.0-SNAPSHOT-job.jar
BPI_DEPLOYMENT_ID=ubuntu-test-v1
BPI_KAFKA_GROUP_PREFIX=ft-mes-bpi
BPI_PARALLELISM=3
BPI_TASKMANAGER_REPLICAS=2
BPI_TASK_SLOTS=3
BPI_JOBMANAGER_MEMORY=1536m
BPI_TASKMANAGER_MEMORY=3072m

BPI_TELEMETRY_TOPIC=iot.telemetry.selected.v1
BPI_CONTEXT_TOPIC=mes.production.context.v1
BPI_RULE_TOPIC=bpi.boundary.rule-publication.v1
BPI_RULE_APPLICATION_TOPIC=bpi.boundary.rule-application.v1
BPI_RULE_APPLICATION_DLQ_TOPIC=bpi.boundary.rule-application.dlq.v1
BPI_CANDIDATE_TOPIC=bpi.batch.candidate.v1
BPI_CANDIDATE_DLQ_TOPIC=bpi.batch.candidate.dlq.v1
BPI_DATA_QUALITY_TOPIC=bpi.data-quality.v1
BPI_DATA_PARTITIONS=6
BPI_CONTROL_PARTITIONS=3

BPI_CHECKPOINT_INTERVAL_MS=30000
BPI_CHECKPOINT_TIMEOUT_MS=120000
BPI_CHECKPOINT_MIN_PAUSE_MS=10000
BPI_CONTEXT_WAIT_MS=120000
BPI_CONTEXT_RETENTION_MS=86400000
BPI_WATERMARK_DELAY_MS=30000
BPI_SOURCE_IDLENESS_MS=60000
BPI_BOUNDARY_STATE_TTL_MS=2592000000
BPI_TRANSACTION_TIMEOUT_MS=900000

# Preflight refuses to deploy below this free-space floor.
BPI_MIN_FREE_DISK_GB=25
BPI_PREFLIGHT_REPORT=/tmp/bpi-streaming-preflight.json
BPI_SMOKE_REPORT=/tmp/bpi-streaming-cluster-smoke.json
BPI_SMOKE_TIMEOUT_SECONDS=360
BPI_REPLAY_TIMEOUT_SECONDS=180
BPI_REPLAY_RULE_SETTLE_MS=5000
BPI_REPLAY_TELEMETRY_SPACING_MS=2000
BPI_REPLAY_RESULT_GRACE_MS=5000
BPI_REPLAY_EVIDENCE_DIR=/tmp/bpi-streaming-evidence
BPI_REPLAY_REPORT=/evidence/bpi-kafka-replay.json
BPI_PERSISTENCE_REPLAY_TIMEOUT_SECONDS=90
BPI_PERSISTENCE_REPLAY_KEEP_MARKER=false

# Joint acceptance consumes the rule published by the real BPI page. It only
# emits scoped MES context and telemetry, then requires exactly one candidate.
BPI_JOINT_TENANT_ID=1000
BPI_JOINT_PLANT_ID=PLANT-01
BPI_JOINT_LINE_ID=LINE-S07-01
BPI_JOINT_TOPOLOGY_CODE=TOPO-S07
BPI_JOINT_TOPOLOGY_VERSION=3
BPI_JOINT_RULE_CODE=RULE-S07-START
BPI_JOINT_RULE_VERSION=1.2.0
BPI_JOINT_DEVICE_ID=DEVICE-S07-01
BPI_JOINT_FLOW_PROPERTY_ID=flow.instant
BPI_JOINT_FLOW_UNIT=t/h
BPI_JOINT_PUMP_PROPERTY_ID=pump.running
BPI_JOINT_PUMP_UNIT=bool
BPI_JOINT_CALIBRATION_VERSION=CAL-1
BPI_JOINT_TIMEOUT_SECONDS=180
BPI_JOINT_TELEMETRY_SPACING_MS=2000
BPI_JOINT_RESULT_GRACE_MS=5000
BPI_JOINT_REPORT=/evidence/bpi-joint-replay.json

# Typed inactive cleanup for one exact rule version after marker acceptance.
BPI_DEACTIVATE_TENANT_ID=1000
BPI_DEACTIVATE_PLANT_ID=PLANT-01
BPI_DEACTIVATE_LINE_ID=LINE-S07-01
BPI_DEACTIVATE_RULE_CODE=RULE-REPLACE-WITH-MARKER
BPI_DEACTIVATE_RULE_VERSION=1
BPI_DEACTIVATE_TIMEOUT_SECONDS=180
BPI_DEACTIVATE_REPORT=/evidence/bpi-rule-deactivation.json
